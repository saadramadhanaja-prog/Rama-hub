-- SCRIPT S LOGO ESP TEMBUS TEMBOK V3 - NO LINE - BUAT DELTA
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UIS = game:GetService("UserInputService")

-- Variabel
local ESP_On = false
local ESP_Objects = {} -- buat nyimpen Highlight

-- GUI UTAMA
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "S_Logo_GUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = game.CoreGui

-- LOGO S BUNDAR YG BISA DIGESER
local Logo = Instance.new("TextButton")
Logo.Size = UDim2.new(0, 50, 0, 50)
Logo.Position = UDim2.new(0, 20, 0.5, -25)
Logo.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
Logo.Text = "S"
Logo.TextColor3 = Color3.fromRGB(255, 255, 255)
Logo.TextScaled = true
Logo.Font = Enum.Font.GothamBold
Logo.Parent = ScreenGui
Logo.ZIndex = 10
Instance.new("UICorner", Logo).CornerRadius = UDim.new(1, 0)

-- Biar bisa di geser
local dragging, dragInput, dragStart, startPos
Logo.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Logo.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		Logo.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
Logo.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)

