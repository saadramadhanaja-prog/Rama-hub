-- FUNGSI CLEAR ESP
local function ClearESP()
	for _,v in pairs(ESP_Objects) do
		if v then v:Destroy() end
	end
	ESP_Objects = {}
end

-- FUNGSI BUAT ESP 1 PLAYER
local function SetupESP(plr)
	if plr == LocalPlayer then return end
	
	local function onChar(char)
		task.wait(0.5)
		
		-- HIGHLIGHT TEMBUS TEMBOK
		local Highlight = Instance.new("Highlight")
	Highlight.Name = "ESP_Highlight"
	Highlight.Adornee = char
		Highlight.FillColor = Color3.fromRGB(0, 170, 255) -- biru
	Highlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- outline putih
	Highlight.FillTransparency = 0.4
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- KUNCI TEMBUS TEMBOK
		Highlight.Parent = game.CoreGui
		table.insert(ESP_Objects, Highlight)
	end
	
	if plr.Character then onChar(plr.Character) end
	plr.CharacterAdded:Connect(onChar)
end

-- EVENT TOMBOL
Logo.MouseButton1Click:Connect(function()
	Menu.Visible = not Menu.Visible -- klik logo buka/tutup
end)

CloseBtn.MouseButton1Click:Connect(function()
	Menu.Visible = false
end)

ESPBtn.MouseButton1Click:Connect(function()
	ESP_On = not ESP_On
	ESPBtn.Text = "ESP Players: "..(ESP_On and "ON" or "OFF")
	
	if ESP_On then
		for _,plr in pairs(Players:GetPlayers()) do SetupESP(plr) end
		Players.PlayerAdded:Connect(SetupESP)
	else
		ClearESP()
	end
end)
